{
  "name": "safestorage-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "storybook": "npm run dev --prefix stories",
    "build": "npm run build --workspace=packages/core && npm run build --workspace=packages/react --workspace=packages/vue --workspace=packages/angular",
    "examples:react": "npm run dev --prefix examples/react-demo",
    "examples:vue": "npm run dev --prefix examples/vue-demo",
    "examples:angular": "npm run start --prefix examples/angular-demo",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/tests/**/*.{ts,tsx}\"",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "typescript": "^5.3.0"
  }
}
